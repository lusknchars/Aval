# ----------------------------------------------------------------------
# AVAL -- environment variables
# Copy to .env and fill in. .env never goes into git.
# ----------------------------------------------------------------------

# Mainnet RPC. Required.
# The Helius api-key is embedded in the query string, so the whole URL is the
# secret -- not just the key.
# Where to get it: https://dashboard.helius.dev -> Endpoints
AVAL_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Devnet RPC. Used by the fixture recorder and the exploration scripts.
AVAL_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Commitment used for reads and simulation.
# "confirmed" is the default. "processed" is faster and less stable;
# "finalized" is too slow for an agent's decision loop.
AVAL_RPC_COMMITMENT=confirmed

# The model the demo agent runs on. Only needed by src/cli/agent.ts, which
# drives a real model to produce a real tool call. Never used by the library
# itself -- no LLM sits in the decision path.
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------------
# The layers built outside this repository. Each is a URL; leave one empty
# and a no-op takes its place, so the pipeline runs whole without any of
# them. See src/adapters/config.ts for the request and response each expects.
# ----------------------------------------------------------------------

# AI as judge (Gemma). Consulted after the deterministic verdict; may only
# tighten it. POST { record, effects, userGoal, toolCall, chunks }
#   -> { tighten: null | { to: "flag"|"deny", reason }, model }
AVAL_JUDGE_URL=

# Input classifier (Prompt Guard). Labels every chunk at capture; never drops.
# POST { text, provenance, source? } -> { label, score, model }
AVAL_GUARD_URL=

# OCR. POST { image: <base64>, mimeType } -> { text, model }
AVAL_OCR_URL=

# Corrector. A cleaner copy for the model; the original is what gets stamped.
# A correction that touches an address or an amount is refused.
# POST { text } -> { text, model }
AVAL_CORRECTOR_URL=

# Sent as a bearer token to all four when set.
AVAL_ADAPTER_TOKEN=
AVAL_ADAPTER_TIMEOUT_MS=5000
