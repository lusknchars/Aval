# ----------------------------------------------------------------------
# VETO -- variaveis de ambiente
# Copie para .env e preencha.  O .env nunca vai para o git.
# ----------------------------------------------------------------------

# RPC de mainnet.  Obrigatoria.
# A chave da Helius vai embutida na query string -- por isso a URL inteira
# e segredo, nao so a chave.
# Onde conseguir: https://dashboard.helius.dev -> Endpoints
VETO_RPC_URL=https://mainnet.helius-rpc.com/?api-key=SUA_CHAVE_AQUI

# RPC de devnet.  Opcional agora; necessaria na etapa 1 (agente vulneravel).
VETO_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=SUA_CHAVE_AQUI

# Commitment usado nas leituras e na simulacao.
# "confirmed" e o padrao.  "processed" e mais rapido e menos estavel;
# "finalized" e mais lento e nao faz sentido no loop do agente.
VETO_RPC_COMMITMENT=confirmed
